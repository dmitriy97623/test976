```
# Arduino build artifacts
*.hex
*.elf
*.bin
*.map
*.sym

# Build directories
build/
dist/

# Dependencies
libraries/

# Logs and temp files
*.log
*.tmp

# Environment
.env
.env.local
.env.*

# Editors
.vscode/
.idea/
.gigacode/
.gigaide/

# OS specific
.DS_Store
Thumbs.db

# Python artifacts (if any Python remains)
__pycache__/
*.pyc
*.pyo
*.pyd
*.py~
```